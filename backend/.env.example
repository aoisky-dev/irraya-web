# Core
PORT=9000
NODE_ENV=development

# Database / cache
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/medusa
REDIS_URL=redis://127.0.0.1:6380

# Security secrets (replace these values)
JWT_SECRET=replace_with_strong_random_string
COOKIE_SECRET=replace_with_strong_random_string

# CORS
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:3000
AUTH_CORS=http://localhost:3000,http://localhost:7001

# Optional: detached/dev auth verification flow
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_TTL_SECONDS=900
# Defaults to JWT_SECRET when omitted.
# VERIFICATION_TOKEN_SECRET=replace_with_strong_random_string

# Future mail/SMS provider integration (not active yet)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Irraya <no-reply@yourdomain.com>
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=

# Optional: sample catalog seeder auth / target
# MEDUSA_ADMIN_TOKEN=
# MEDUSA_ADMIN_EMAIL=admin@irraya.com
# MEDUSA_ADMIN_PASSWORD=Admin@12345
# MEDUSA_BACKEND_URL=http://localhost:9000
# SEED_CATALOG_CURRENCY=inr

