{
  "name": "irraya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend skeleton for fashion commerce with Medusa-oriented architecture",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
