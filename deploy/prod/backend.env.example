# This file is for documentation purposes. 
# Copy it to backend.env and fill in the values on your server.

JWT_SECRET=supersecret_jwt_key_change_me
COOKIE_SECRET=supersecret_cookie_key_change_me

# Leave these empty if using the default Postgres settings in docker-compose.prod.yml
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=irraya

# Medusa specific
STORE_CORS=https://your-domain.com
ADMIN_CORS=https://admin.your-domain.com

DATABASE_URL=postgresql://postgres:postgres@db:5432/irraya
REDIS_URL=redis://redis:6379
